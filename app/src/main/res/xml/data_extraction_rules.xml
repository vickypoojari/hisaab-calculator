<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. History stays out of cloud backup (the app promises nothing leaves the
     phone); a direct phone-to-phone transfer started by the person still carries it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="history.db" />
        <exclude domain="database" path="history.db-journal" />
    </cloud-backup>
</data-extraction-rules>
