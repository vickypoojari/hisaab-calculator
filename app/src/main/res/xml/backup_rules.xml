<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. History holds what people calculated (often money), and the sheet promises
     "Nothing is sent anywhere", so it stays out of cloud backup. -->
<full-backup-content>
    <exclude domain="database" path="history.db" />
    <exclude domain="database" path="history.db-journal" />
</full-backup-content>
